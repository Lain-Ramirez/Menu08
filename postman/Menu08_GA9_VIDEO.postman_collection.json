      "name": "Recorrido validado para video",
      "item": [
        {
          "name": "01 GET /ingresar (captura el token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingresar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingresar"
              ]
            },
            "description": "Pide el formulario de ingreso. Lo unico que interesa es el campo oculto _token, que el script guarda en la variable {{token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "// Guarda el _token del formulario para el siguiente POST.",
                  "const m = pm.response.text().match(/name=\"_token\" value=\"([a-f0-9]+)\"/);",
                  "if (m) { pm.collectionVariables.set('token', m[1]); }",
                  "pm.test('Se capturo el token', function () { pm.expect(m, 'no hay _token en la pagina').to.not.be.null; });"
                ]
              }
            }
          ]
        },
