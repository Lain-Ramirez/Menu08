        {
          "name": "06 GET /caja (captura el token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/caja",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "caja"
              ]
            },
            "description": "Pantalla de venta. Cada casilla de cantidad se llama cantidad[<id de producto>]: aqui se ven los identificadores reales del catalogo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "// Guarda el _token del formulario para el siguiente POST.",
                  "const m = pm.response.text().match(/name=\"_token\" value=\"([a-f0-9]+)\"/);",
                  "if (m) { pm.collectionVariables.set('token', m[1]); }",
                  "pm.test('Se capturo el token', function () { pm.expect(m, 'no hay _token en la pagina').to.not.be.null; });",
                  "const html = pm.response.text();",
                  "for (const pair of [['papasId','Papas de prueba'],['hamburguesaId','Hamburguesa de prueba']]) {",
                  " const tags = html.match(/<button[\\s\\S]*?<\\/button>/g) || [];",
                  " const tag = tags.find(t => t.includes('data-nombre=\"'+pair[1]+'\"'));",
                  " const m = tag && tag.match(/data-venta-agregar=\"(\\d+)\"/);",
                  " pm.test('ID dinámico '+pair[0],()=>pm.expect(m).not.to.be.null);",
                  " if (m) pm.collectionVariables.set(pair[0],m[1]);",
                  "}"
                ]
              }
            }
          ]
        },
