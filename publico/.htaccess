# Menu08 - Toda peticion que no sea un archivo real se resuelve por index.php.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Los archivos y carpetas que existen se sirven tal cual (css, js, imagenes).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demas va al front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

# Nunca servir archivos sensibles aunque queden dentro de publico por error.
<FilesMatch "\.(sql|log|md|ejemplo\.php)$">
    Require all denied
</FilesMatch>
